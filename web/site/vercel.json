{
  "cleanUrls": true,
  "redirects": [{ "source": "/app", "destination": "/app/", "permanent": false }],
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    { "source": "/app/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/app/flutter_bootstrap.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/app/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/app/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/ar/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
