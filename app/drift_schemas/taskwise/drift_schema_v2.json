    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"updated_by_device\" TEXT NULL, \"title\" TEXT NOT NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"due_date\" TEXT NULL, \"due_time_minutes\" INTEGER NULL, \"priority\" TEXT NOT NULL DEFAULT 'none', \"category_id\" TEXT NULL, \"done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"done\" IN (0, 1)), \"completed_at\" INTEGER NULL, \"recurrence_rule\" TEXT NULL, \"notify_all_devices\" INTEGER NOT NULL DEFAULT 1 CHECK (\"notify_all_devices\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
