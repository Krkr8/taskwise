# Copy to .env for local development (`npm run dev`). Never commit .env.
# On Vercel, set these in Project → Settings → Environment Variables.

# libSQL database. Turso: libsql://<db>-<org>.turso.io. Local: file:taskwise.db
DATABASE_URL=file:taskwise.db
# Turso auth token (leave empty for a local file database).
DATABASE_AUTH_TOKEN=

# Long random secret needed once to create the account: openssl rand -base64 32
SETUP_SECRET=

# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>": openssl rand -hex 32
CRON_SECRET=

# Port for the plain Node server (not used on Vercel).
PORT=8787
