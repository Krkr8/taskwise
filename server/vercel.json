{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/v1/cron/daily",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/push-delivery.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "taskwise-push"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/:path*"
    }
  ]
}
